---
import "../styles/global.css";
import { sitePath } from "../lib/urls.ts";
import { events } from "../lib/data.ts";

const title = "MOLU";
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#daeefd" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta
      name="description"
      content="블루 아카이브(한국 서버) 공식 공지에서 매주 모은 점검·픽업·이벤트·총력전·캠페인 일정을 한눈에 보는 비공식 팬 캘린더."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content="공식 공지에서 매주 모은 픽업·이벤트·총력전·캠페인 일정. 원문 링크와 캘린더 구독 지원."
    />
    <meta property="og:locale" content="ko_KR" />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <link
      rel="preload"
      href={sitePath("fonts/gyeonggi-title-bold-subset.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="text/calendar"
      title="MOLU 전체 일정 (iCalendar)"
      href={sitePath("feeds/all.ics")}
    />
  </head>
  <body>
    <div id="root"></div>
    <noscript>
      <p class="p-6 text-center">
        캘린더를 보려면 JavaScript를 켜 주세요. 일정 원본: <a
          href={sitePath("data/events.json")}>events.json</a
        >
      </p>
    </noscript>
    <script
      type="application/json"
      id="events"
      set:html={JSON.stringify(events).replaceAll("<", "\\u003c")}
    />
    <script>
      import "../main.tsx";
    </script>
  </body>
</html>
