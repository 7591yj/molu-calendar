/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://dszw1qtcnsa5e.cloudfront.net; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=2592000

/data/*
  Cache-Control: public, max-age=300, must-revalidate
  Access-Control-Allow-Origin: *

/feeds/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *

/schema.json
  Access-Control-Allow-Origin: *
